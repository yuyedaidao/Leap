---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Leap · 从一个搜索框，开始你的下一步', description = 'Leap 是为 Mac 打造的快捷启动器。从一个搜索框启动应用，通过本地插件处理文本和日常操作。' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const icp = import.meta.env.ICP_NUMBER;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/media/icon.png" />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} /><meta property="og:locale" content="zh_CN" />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL('/media/share.png', Astro.site)} />}
    <meta name="theme-color" content="#f7f6fb" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="Leap 首页"><img src="/media/icon.png" width="38" height="38" alt="" />Leap</a>
      <nav aria-label="主导航"><a href="/#features">功能</a><a href="/guide/" aria-current={Astro.url.pathname === '/guide/' ? 'page' : undefined}>使用指南</a><a href="/developers/" aria-current={Astro.url.pathname === '/developers/' ? 'page' : undefined}>开发者</a></nav>
      <a class="nav-download" href="/#download">获取 Leap <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell">
      <a class="brand" href="/"><img src="/media/icon.png" width="28" height="28" alt="" />Leap</a>
      <p>留在手边，接住你的下一步。</p>
      <div><a href="/guide/">使用指南</a><a href="/developers/">开发者文档</a><a href="/privacy/">隐私说明</a>{icp && <a href="https://beian.miit.gov.cn/" rel="external">{icp}</a>}</div>
    </footer>
  </body>
</html>
