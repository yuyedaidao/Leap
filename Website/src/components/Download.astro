---
import release from '../../release.json';
const available = Boolean(release.downloadURL);
---
<div class="download-actions">
  {available ? <a class="button primary" href={release.downloadURL!}>下载 Leap <span aria-hidden="true">↓</span></a> : <button class="button primary" disabled>下载即将开放</button>}
  {Astro.url.pathname !== '/guide/' && <a class="button secondary" href="/guide/">先看看使用指南 <span aria-hidden="true">→</span></a>}
</div>
<p class="system-note">macOS {release.minimumMacOS.split('.')[0]}+ · Apple Silicon <span>版本 {release.version}</span></p>
{available && <details class="checksum"><summary>安装包信息与校验</summary><p>大小：{(release.sizeBytes! / 1024 / 1024).toFixed(1)} MB</p><p>SHA256：<code>{release.sha256}</code></p></details>}
